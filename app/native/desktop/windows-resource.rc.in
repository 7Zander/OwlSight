#include <windows.h>
IDI_ICON1 ICON "@OWLSIGHT_ICON_ICO@"
1 VERSIONINFO
FILEVERSION @OwlSightQtQuick_VERSION_MAJOR@,@OwlSightQtQuick_VERSION_MINOR@,@OwlSightQtQuick_VERSION_PATCH@,@OWLSIGHT_BUILD_NUMBER@
PRODUCTVERSION @OwlSightQtQuick_VERSION_MAJOR@,@OwlSightQtQuick_VERSION_MINOR@,@OwlSightQtQuick_VERSION_PATCH@,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
 BLOCK "StringFileInfo"
 BEGIN
  BLOCK "040904b0"
  BEGIN
   VALUE "CompanyName", "OwlSight\0"
   VALUE "FileDescription", "@OWLSIGHT_RESOURCE_DESCRIPTION@\0"
   VALUE "FileVersion", "@OWLSIGHT_VERSION@.@OWLSIGHT_BUILD_NUMBER@\0"
   VALUE "InternalName", "@OWLSIGHT_RESOURCE_NAME@\0"
   VALUE "OriginalFilename", "@OWLSIGHT_RESOURCE_NAME@.exe\0"
   VALUE "ProductName", "OwlSight\0"
   VALUE "ProductVersion", "@OWLSIGHT_VERSION@\0"
   VALUE "LegalCopyright", "OwlSight contributors; GPL-3.0-or-later\0"
  END
 END
 BLOCK "VarFileInfo"
 BEGIN
  VALUE "Translation", 0x0409, 1200
 END
END
